# Команда Start
@dp.message(Command("start"))
async def start_cmd(message: types.Message, command: CommandObject, state: FSMContext):
    await state.clear()
    uid = message.from_user.id
    check_and_reset_monthly_limit(uid)

    if uid not in known_users:
        known_users.add(uid)
        args = command.args
        if args and args.startswith("ref_"):
            try:
                referrer_id = int(args.split("_")[1])
                if referrer_id != uid:
                    check_and_reset_monthly_limit(referrer_id)
                    user_bonus_rooms[referrer_id] = user_bonus_rooms.get(referrer_id, 0) + 1
                    try:
                        await bot.send_message(
                            referrer_id,
                            f"🎉 **По вашей ссылке зарегистрировался новый пользователь!**\n\n"
                            f"🎁 Вам начислена **+1 доп. комната**!",
                            parse_mode="Markdown",
                            reply_markup=main_keyboard(referrer_id)
                        )
                    except Exception:
                        pass
            except ValueError:
                pass

    if uid in random_queue:
        random_queue.remove(uid)

    if uid in active_chats:
        peer_id = active_chats.pop(uid, None)
        if peer_id and peer_id in active_chats:
            active_chats.pop(peer_id, None)
            await bot.send_message(peer_id, "💔 Собеседник покинул чат.", reply_markup=main_keyboard(peer_id))

    await message.answer_photo(
        photo=IMG_START,
        caption="✨ **Добро пожаловать в «Приватный Чат»!** ✨\n\nСоздавайте комнаты по ПИН-коду или ищите случайных собеседников!",
        parse_mode="Markdown",
        reply_markup=main_keyboard(uid)
    )

