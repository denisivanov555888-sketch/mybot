# Комнаты по ПИН
@dp.message(F.text.contains("Создать комнату"))
async def create_room(message: types.Message):
    uid = message.from_user.id
    if uid in active_chats:
        await message.answer("⚠️ Вы уже в диалоге!")
        return

    pin = str(random.randint(1000, 9999))
    rooms[pin] = uid
    await message.answer_photo(photo=IMG_ROOM, caption=f"🔒 **Комната создана!**\n\n🔑 ПИН-код: `{pin}`\nПередайте этот код собеседнику.", parse_mode="Markdown")

@dp.message(F.text.contains("Войти по ПИН"))
async def enter_pin_prompt(message: types.Message, state: FSMContext):
    await state.set_state(ChatState.waiting_for_pin)
    await message.answer("🔢 **Введите ПИН-код:**", reply_markup=ReplyKeyboardRemove())

@dp.message(ChatState.waiting_for_pin)
async def process_pin(message: types.Message, state: FSMContext):
    pin = message.text.strip()
    uid = message.from_user.id
    if pin in rooms:
        host_id = rooms.pop(pin)
        active_chats[uid] = host_id
        active_chats[host_id] = uid
        await state.set_state(ChatState.in_chat)
        await message.answer("🟢 **Вы подключились к чату!**", reply_markup=in_chat_keyboard())
        await bot.send_message(host_id, "🟢 **Собеседник подключился!**", reply_markup=in_chat_keyboard())
    else:
        await message.answer("❌ Неверный ПИН-код.", reply_markup=main_keyboard(uid))
        await state.clear()

@dp.message(F.text == "❌ Завершить диалог")
async def leave_chat(message: types.Message, state: FSMContext):
    uid = message.from_user.id
    if uid in active_chats:
        peer_id = active_chats.pop(uid)
        if peer_id in active_chats:
            active_chats.pop(peer_id)
            await bot.send_message(peer_id, "🔴 Собеседник завершил диалог.", reply_markup=main_keyboard(peer_id))
        await state.clear()
        await message.answer("🚪 Вы вышли из чата.", reply_markup=main_keyboard(uid))

# Пересылка сообщений
@dp.message()
async def relay_message(message: types.Message):
    uid = message.from_user.id
    if uid not in active_chats:
        await message.answer("👇 Выберите действие в меню:", reply_markup=main_keyboard(uid))
        return
    peer_id = active_chats[uid]
    try:
        await message.copy_to(chat_id=peer_id)
    except Exception:
        await message.answer("⚠️ Не удалось доставить сообщение.")

