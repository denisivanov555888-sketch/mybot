# Данные в памяти
rooms = {}                 # pin -> user_id
active_chats = {}          # user_id -> target_user_id
chat_msg_count = {}        # (u1, u2) -> count
user_rooms_created = {}    # user_id -> int
user_bonus_rooms = {}      # user_id -> int
user_reset_date = {}       # user_id -> datetime
vip_users = {}             # user_id -> datetime
known_users = set()        

random_queue = []          

FREE_ROOMS_LIMIT = 2

class ChatState(StatesGroup):
    waiting_for_pin = State()
    in_chat = State()

def is_vip(user_id: int) -> bool:
    if user_id in vip_users:
        if datetime.now() < vip_users[user_id]:
            return True
        else:
            del vip_users[user_id]
    return False

def check_and_reset_monthly_limit(user_id: int):
    now = datetime.now()
    if user_id not in user_reset_date:
        user_reset_date[user_id] = now + timedelta(days=30)
        user_rooms_created[user_id] = 0
        user_bonus_rooms[user_id] = 0
    elif now >= user_reset_date[user_id]:
        user_rooms_created[user_id] = 0
        user_bonus_rooms[user_id] = 0
        user_reset_date[user_id] = now + timedelta(days=30)

def get_total_rooms_limit(user_id: int) -> int:
    bonus = user_bonus_rooms.get(user_id, 0)
    return FREE_ROOMS_LIMIT + bonus

def get_chat_key(u1: int, u2: int):
    return tuple(sorted([u1, u2]))

# Клавиатуры
def main_keyboard(user_id: int):
    check_and_reset_monthly_limit(user_id)
    created = user_rooms_created.get(user_id, 0)
    total_limit = get_total_rooms_limit(user_id)
    left_rooms = max(0, total_limit - created)
    
    if is_vip(user_id):
        room_btn = "🔑 Создать комнату (♾️ VIP)"
        vip_btn = "👑 VIP Статус"
    else:
        room_btn = f"🔑 Создать комнату ({left_rooms}/{total_limit})"
        vip_btn = "🔥 СКИДКА: VIP 50 ⭐️"

    kb = [
        [KeyboardButton(text="🎲 Случайный собеседник")],
        [KeyboardButton(text=room_btn), KeyboardButton(text="🚪 Войти по ПИН")],
        [KeyboardButton(text="👤 Профиль"), KeyboardButton(text="🤝 Реферальная программа")],
        [KeyboardButton(text=vip_btn), KeyboardButton(text="⭐️ Поддержать проект")]
    ]
    return ReplyKeyboardMarkup(keyboard=kb, resize_keyboard=True)

