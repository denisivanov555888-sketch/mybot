@dp.message(F.text == "⏭️ Следующий собеседник")
async def next_partner(message: types.Message, state: FSMContext):
    uid = message.from_user.id
    if uid in active_chats:
        peer_id = active_chats.pop(uid)
        if peer_id in active_chats:
            active_chats.pop(peer_id)
            await bot.send_message(peer_id, "🔴 Собеседник перешел к следующему чату.", reply_markup=main_keyboard(peer_id))
        await state.clear()
        await start_random_search(message, state)

