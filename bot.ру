# Поиск случайного собеседника
@dp.message(F.text == "🎲 Случайный собеседник")
async def start_random_search(message: types.Message, state: FSMContext):
    uid = message.from_user.id
    if uid in active_chats:
        await message.answer("⚠️ Вы уже в диалоге!")
        return
    if uid in random_queue:
        await message.answer("🔍 Вы уже ищете собеседника...")
        return

    if len(random_queue) > 0:
        peer_id = random_queue.pop(0)
        active_chats[uid] = peer_id
        active_chats[peer_id] = uid
        chat_key = get_chat_key(uid, peer_id)
        chat_msg_count[chat_key] = 0

        await state.set_state(ChatState.in_chat)
        await message.answer("🎉 **Собеседник найден!** Приятного общения!", reply_markup=in_chat_keyboard())
        await bot.send_message(peer_id, "🎉 **Собеседник найден!** Приятного общения!", reply_markup=in_chat_keyboard())
    else:
        random_queue.append(uid)
        await message.answer("🔍 **Ищем свободного собеседника...**", reply_markup=searching_keyboard())

@dp.message(F.text == "❌ Отменить поиск")
async def cancel_search(message: types.Message):
